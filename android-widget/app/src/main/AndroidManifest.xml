<manifest xmlns:android="http://schemas.android.com/apk/res/android">
<uses-permission android:name="android.permission.INTERNET"/><uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
<application android:theme="@android:style/Theme.Material.Light.NoActionBar" android:label="Love Notes Widget" android:icon="@drawable/ic_heart" android:allowBackup="false" android:usesCleartextTraffic="false" android:supportsRtl="true">
